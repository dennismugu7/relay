# Store text files with LF line endings in the repo and in working copies,
# on every OS. Without this, Git on Windows may convert files to CRLF and
# Prettier (which expects LF) would report every file as badly formatted.
* text=auto eol=lf

# Windows scripts need CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
